<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Héroes Fluent</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-light bg-white border-bottom mb-4">
            <div class="container">
                <a class="navbar-brand" asp-controller="Heroes" asp-action="Index">Héroes Fluent</a>
                <div class="navbar-nav flex-row gap-3">
                    <a class="nav-link" asp-controller="Equipos" asp-action="Index">Equipos</a>
                    <a class="nav-link" asp-controller="Heroes" asp-action="Index">Héroes</a>
                </div>
            </div>
        </nav>
    </header>
    <div class="container"><main role="main" class="pb-4">@RenderBody()</main></div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
